# Firebase browser configuration — copy this file to .env.local and fill in the
# values from Firebase Console -> Project settings -> Your apps -> Web app.
#
# These are public client identifiers, not secrets: they name the project and
# are shipped in the bundle by design. Protection comes from Firestore Security
# Rules and, later, App Check. Never put service-account credentials, Admin SDK
# keys or payment secrets in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
