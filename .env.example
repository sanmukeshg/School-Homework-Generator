# Firebase browser configuration — copy this file to .env.local and fill in the
# values from Firebase Console -> Project settings -> Your apps -> Web app.
#
# These are public client identifiers, not secrets: they name the project and
# are shipped in the bundle by design. Protection comes from Firestore Security
# Rules and, later, App Check. Never put service-account credentials, Admin SDK
# keys or payment secrets in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase App Check (optional) ---------------------------------------
# Leave blank and App Check stays inactive: the app runs exactly as before.
# Create the site key in Firebase Console -> App Check -> Apps -> register the
# web app. Enforcement is a separate Console setting and should stay off until
# the App Check metrics show verified traffic arriving.
VITE_APPCHECK_SITE_KEY=
# 'recaptcha-v3' (default) or 'recaptcha-enterprise'
VITE_APPCHECK_PROVIDER=
# Development only. A token registered under App Check -> Apps -> Manage debug
# tokens, or 'true' to have the SDK print a fresh one to the console.
# Never set this in a production build.
VITE_APPCHECK_DEBUG_TOKEN=
