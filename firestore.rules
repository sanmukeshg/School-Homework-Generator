rules_version = '2';

// Homework Generator — Firestore Security Rules
//
// Everything is denied unless a rule below allows it, and every rule is scoped
// to the signed-in user's own uid taken from request.auth — never from a value
// the client sends.
//
// Covered so far: the profile and the account record. Settings and homework are
// still local-only and are therefore still denied; their rules land with the
// migration that starts writing them.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // A convenience copy of the Google profile. Nothing depends on it, but it
    // is still the user's own data and nobody else may read it.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        // Server clock, not the device's.
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLoginAt == request.time;

      allow delete: if false;

      // Settings and homework are not written to the cloud yet.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // The account record. A client may bring its own trial into existence and
    // may never touch it again: no extending it, no switching itself to a paid
    // plan, no writing payment fields. Those changes come from a trusted
    // backend using the Admin SDK, which bypasses these rules entirely.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.plan == 'trial'
        && request.resource.data.status == 'active'
        // The start is the server's clock; the end is stamped by the one
        // follow-up write allowed below.
        && request.resource.data.trialStartedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.trialEndsAt == null
        && request.resource.data.subscriptionStartedAt == null
        && request.resource.data.subscriptionEndsAt == null
        && request.resource.data.paymentProvider == null
        && request.resource.data.paymentCustomerId == null
        && request.resource.data.paymentSubscriptionId == null;

      // Exactly one follow-up write, to record when the trial ends. Allowed
      // only while that field is still empty, and only that field may change.
      allow update: if isOwner(uid)
        && resource.data.trialEndsAt == null
        && request.resource.data.trialEndsAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['trialEndsAt', 'updatedAt']);

      allow delete: if false;
    }
  }
}
