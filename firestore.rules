rules_version = '2';

// Homework Generator — Firestore Security Rules
//
// STATUS: foundation only.
//
// The application does not read or write Firestore yet: Step 1 wires up the
// SDK and Hosting, nothing more. Until Google Authentication is integrated
// there is no request.auth to check ownership against, so the only correct
// posture is to deny everything. This is deliberately restrictive rather than
// permissive — an open rule would expose the database the moment anyone found
// the project id.
//
// The ownership rules (users/{uid}, users/{uid}/settings, homework and
// subscriptions, with payment fields writable only by a trusted backend) are
// deferred to the authentication and security phase, and must be written and
// reviewed there before this file is deployed with any allow.
//
// This file is NOT deployed in Step 1. Firestore currently runs on whatever
// rules the Console created; deploying rules is part of the security phase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
